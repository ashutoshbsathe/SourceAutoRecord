# Local environment overrides for the SourceAutoRecord install/launch scripts.
# Copy this file to `.env` and adjust as needed:
#
#   cp .env.example .env
#
# STEAM_ROOT: your Steam root directory. Portal 2 is expected at
#   $STEAM_ROOT/steamapps/common/Portal 2/
#
# Leave it unset to use the default (~/.steam/root), which is correct for most
# standard Steam installs. Uncomment and edit only if your Steam library lives
# elsewhere (e.g. a secondary drive).
#
#STEAM_ROOT=/home/youruser/.steam/root
